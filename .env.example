# Copy to .env and fill in. Loaded automatically at startup (see main.py).

# Optional APIs
CRYPTOPANIC_API_KEY=
COINMETRICS_API_KEY=
COINMARKETCAP_API_KEY=
GLASSNODE_API_KEY=

# Sentiment ingest
# ENABLE_FINBERT_ON_INGEST=1
# FINBERT_MODEL_NAME=ProsusAI/finbert
# FINBERT_BATCH_SIZE=16

# Experiments (optional)
# CRYPTO_HORSERACE_DATA_EXPERIMENT=default
# CRYPTO_HORSERACE_POOLED_DL=0

# Horserace baselines: set to 0 to skip heavy runs
# RUN_SVR_BASELINE=1
# RUN_DL_ABLATION_BASELINES=1
# RUN_HAR_GJR_BASELINES=1
# RUN_NAIVE_PERSISTENCE_BASELINE=1

# SVR (when RUN_SVR_BASELINE=1)
# SVR_C=10.0
# SVR_GAMMA=scale
# SVR_EPSILON=0.01
